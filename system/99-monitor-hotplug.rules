# Genaktivér intern skærm (eDP) når alle eksterne skærme frakobles.
# Kører bin/monitor-hotplug som brugeren på DRM-change.
# Installér:
#   sudo install -Dm644 system/99-monitor-hotplug.rules /etc/udev/rules.d/99-monitor-hotplug.rules
#   sudo udevadm control --reload-rules
ACTION=="change", SUBSYSTEM=="drm", RUN+="/usr/bin/runuser -u magnus -- /home/magnus/.local/bin/monitor-hotplug"
