#!/usr/bin/env bash

set -euo pipefail

user=${1:-$USER}
[[ $user != root ]] || { printf 'Refusing to configure root autologin.\n' >&2; exit 1; }

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<EOF
[Autologin]
User=$user
Session=plasma.desktop
EOF

sudo install -Dm644 "$tmp" /etc/sddm.conf.d/autologin.conf
printf 'SDDM autologin er aktiveret for %s (Plasma-session).\n' "$user"
