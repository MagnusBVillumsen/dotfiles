#!/usr/bin/env bash

set -euo pipefail

nmcli radio wifi on >/dev/null
nmcli device wifi rescan >/dev/null 2>&1 || true
sleep 1

ssid=$(nmcli -t -f SSID device wifi list |
    sed 's/\\:/\\x3a/g' |
    awk 'NF && !seen[$0]++' |
    fuzzel --dmenu --prompt 'WiFi  ' --width 42 --lines 12) || exit 0

[[ $ssid ]] || exit 0

if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
    notify-send 'WiFi' "Forbundet til $ssid"
    exit 0
fi

password=$(fuzzel --dmenu --password --prompt "Password til $ssid  ") || exit 0
[[ $password ]] || exit 0
nmcli device wifi connect "$ssid" password "$password" >/dev/null
notify-send 'WiFi' "Forbundet til $ssid"
