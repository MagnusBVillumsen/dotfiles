#!/usr/bin/env bash

set -u

state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/minimized-state"
touch "$state"

win=$(hyprctl activewindow -j 2>/dev/null) || exit 0
read -r addr ws < <(python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d.get("address", ""), d.get("workspace", {}).get("name", ""))
' <<<"$win")

[[ -n $addr && -n $ws ]] || exit 0

grep -v "^$addr " "$state" > "$state.tmp" 2>/dev/null || true
printf '%s %s\n' "$addr" "$ws" >> "$state.tmp"
mv "$state.tmp" "$state"

hyprctl eval 'hl.dispatch(hl.dsp.window.move({ workspace = "special:minimized" }))' >/dev/null 2>&1
