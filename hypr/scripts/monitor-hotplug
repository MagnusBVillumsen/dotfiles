#!/usr/bin/env bash

set -u

exec 9="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monitor-hotplug.lock"
flock -n 9 || exit 0

while sleep 2; do
    monitors=$(hyprctl monitors 2>/dev/null) || continue
    external_count=$(awk '/^Monitor / { if ($2 != "eDP-1") count++ } END { print count + 0 }' <<<"$monitors")
    if [[ $external_count -eq 0 ]]; then
        hyprctl eval 'hl.dispatch(hl.dsp.dpms({ monitor = "eDP-1", action = "enable" }))' >/dev/null 2>&1 || true
    fi
done
