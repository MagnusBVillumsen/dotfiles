#!/usr/bin/env bash

set -euo pipefail

script=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script")/../.." && pwd)

choice=$(
    for directory in "$repo"/themes/*; do
        [[ -d $directory ]] || continue
        theme=${directory##*/}
        name=$(sed -n 's/^name=//p' "$directory/theme.conf")
        printf '%s\t%s\n' "$name" "$theme"
    done | fuzzel --dmenu --prompt 'Tema  ' --width 38 --lines 10
) || exit 0

theme=${choice##*$'\t'}
"$repo/bin/theme-set" "$theme" --apply
