#!/usr/bin/env bash

set -u

# Udskriver navnet på den primære skærm: største eksterne hvis nogen er
# tilsluttet, ellers den interne eDP-1.
monitors=$(hyprctl monitors -j 2>/dev/null) || { printf 'eDP-1\n'; exit 0; }

python3 -c '
import json, sys

monitors = json.load(sys.stdin)
external = [m for m in monitors if m.get("name") != "eDP-1"]
if external:
    print(max(external, key=lambda m: m.get("width", 0) * m.get("height", 0))["name"])
else:
    print("eDP-1")
' <<<"$monitors"
