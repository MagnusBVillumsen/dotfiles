#!/usr/bin/env bash

set -euo pipefail

version=${Z13CTL_VERSION:-1.3.1}
archive="z13ctl_${version}_linux_amd64.tar.gz"
base_url="https://github.com/dahui/z13ctl/releases/download/v${version}"
workdir=$(mktemp -d /tmp/z13ctl-install.XXXXXX)
trap 'rm -rf "$workdir"' EXIT

curl -fsSL "$base_url/$archive" -o "$workdir/$archive"
curl -fsSL "$base_url/checksums.txt" -o "$workdir/checksums.txt"
(
    cd "$workdir"
    sha256sum --check checksums.txt --ignore-missing
)

tar -xzf "$workdir/$archive" -C "$workdir"
binary=$(find "$workdir" -type f -name z13ctl -perm -u+x -print -quit)
if [[ -z $binary ]]; then
    printf 'Arkivet indeholdt ikke en eksekverbar z13ctl-binær.\n' >&2
    exit 1
fi

install -Dm755 "$binary" "$HOME/.local/bin/z13ctl"
"$HOME/.local/bin/z13ctl" --version
