[Unit]
Description=z13gui GTK4 overlay for z13ctl
Documentation=https://github.com/dahui/z13gui
After=graphical-session.target z13ctl.socket
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/z13gui
Environment=GTK_A11Y=none
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
